# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_DATABASE=Plataforma

# Carpeta donde se guardan las fotos de los elementos.
# En desarrollo se puede omitir: se usa storage/fotos del proyecto.
# En producción tiene que ser una ruta absoluta del servidor, fuera de la
# carpeta del código, por ejemplo D:\datos\inventario o /datos/inventario
# FOTOS_DIR=/datos/inventario

# Correo SMTP. Sirve para recuperar contraseña y para avisar cada notificación.
# Gmail gratis: cuenta de Google, contraseña de aplicación (no la clave normal).
# Si esa cuenta se bloquea o llega al tope del día, se cambian solo estas dos:
# MAIL_USERNAME y MAIL_PASSWORD. El resto del sistema no cambia.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USERNAME=cuenta@gmail.com
# MAIL_PASSWORD=contraseña-de-aplicacion
# MAIL_FROM=cuenta@gmail.com
# MAIL_FROM_NAME=Sigma